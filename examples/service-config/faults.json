{
 "base": "base",
 "check": "python3 {here}/checks.py {dir}",
 "faults": [
  {"name": "config.json is not JSON", "check": "parse",
   "edits": [{"write": {"file": "config.json", "text": "{port: 8080"}}]},
  {"name": "config.json is gone", "check": "parse",
   "edits": [{"delete": {"file": "config.json"}}]},
  {"name": "health_path missing", "check": "fields", "contains": "health_path",
   "edits": [{"json_delete": {"file": "config.json", "path": "health_path"}}]},
  {"name": "port given as a string", "check": "fields", "contains": "port",
   "edits": [{"json_set": {"file": "config.json", "path": "port", "value": "8080"}}]},
  {"name": "name with capitals and an underscore", "check": "name",
   "edits": [{"json_set": {"file": "config.json", "path": "name", "value": "Payments_API"}}]},
  {"name": "port below 1024", "check": "port", "contains": "80 ",
   "edits": [{"replace": {"file": "config.json", "old": "\"port\": 8080", "new": "\"port\": 80"}}]},
  {"name": "port above 65535", "check": "port",
   "edits": [{"json_set": {"file": "config.json", "path": "port", "value": 70000}}]},
  {"name": "port 1024 is allowed", "check": "port", "expect": "pass",
   "edits": [{"json_set": {"file": "config.json", "path": "port", "value": 1024}}]},
  {"name": "no replicas", "check": "replicas",
   "edits": [{"json_set": {"file": "config.json", "path": "replicas", "value": 0}}]},
  {"name": "one replica warns", "check": "replicas", "expect": "warn",
   "edits": [{"json_set": {"file": "config.json", "path": "replicas", "value": 1}}]},
  {"name": "connect timeout longer than the request", "check": "timeouts", "contains": "not below",
   "edits": [{"json_set": {"file": "config.json", "path": "timeouts.connect_ms", "value": 5000}}]},
  {"name": "request timeout over a minute", "check": "timeouts", "contains": "over a minute",
   "edits": [{"json_set": {"file": "config.json", "path": "timeouts.request_ms", "value": 90000}}]},
  {"name": "negative connect timeout", "check": "timeouts",
   "edits": [{"json_set": {"file": "config.json", "path": "timeouts.connect_ms", "value": -1}}]},
  {"name": "unknown log level", "check": "log_level",
   "edits": [{"json_set": {"file": "config.json", "path": "log_level", "value": "verbose"}}]},
  {"name": "debug logging warns", "check": "log_level", "expect": "warn",
   "edits": [{"json_set": {"file": "config.json", "path": "log_level", "value": "debug"}}]},
  {"name": "health path without a slash", "check": "health_path",
   "edits": [{"json_set": {"file": "config.json", "path": "health_path", "value": "healthz"}}]},
  {"name": "a misspelled key warns", "check": "unknown_keys", "expect": "warn", "contains": "replcias",
   "edits": [{"json_set": {"file": "config.json", "path": "replcias", "value": 3}}]}
 ]
}
